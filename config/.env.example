# Mẫu biến môi trường. Chép thành config/.env rồi điền giá trị thật.
# Tệp .env thật KHÔNG được đưa lên kho mã nguồn.

# ── Django ──────────────────────────────────────────────────────────
# Trên máy chủ bắt buộc phải đặt khoá thật, sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=doi-gia-tri-nay-truoc-khi-len-may-chu
DJANGO_SETTINGS_MODULE=knjsc.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://knjsc.example.com

# ── Cơ sở dữ liệu ───────────────────────────────────────────────────
POSTGRES_DB=knjsc_db
POSTGRES_USER=knjsc
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Hàng đợi ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Phiên đăng nhập ─────────────────────────────────────────────────
# Hết phiên sau 60 phút không thao tác — FR-1.3
SESSION_IDLE_TIMEOUT_SECONDS=3600

# ── Vận hành ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RUN_MIGRATIONS=0
